{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed anti-fraud pattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "scam_type",
    "status",
    "observable_cues",
    "fraud_mechanism",
    "false_positive_contexts",
    "recommended_user_action",
    "source_ids",
    "reviewed_by",
    "reviewed_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PAT-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "scam_type": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "enum": [
        "draft",
        "needs_review",
        "approved",
        "withdrawn"
      ]
    },
    "observable_cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "fraud_mechanism": {
      "type": "string"
    },
    "false_positive_contexts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_user_action": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{8}-[0-9]{3}$"
      }
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "reviewed_by": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "minLength": 10
          },
          "false_positive_contexts": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
